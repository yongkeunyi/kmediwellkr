  document.getElementById('localeSel').value = locale;
  updateAuthPill();
  renderNav();
  document.querySelectorAll('nav.tabs button').forEach(b=>b.classList.toggle('active', b.dataset.tab===currentView));
  renderHome();
  renderExplore();
  renderNews();
  renderEbooks();
  animateWave();
}
function animateWave(){
  const path = document.getElementById('eegpath');
  if(!path) return;
  let t = 0;
  function frame(){
    t += 0.02;
    let d = 'M0,60 ';
    for(let x=0;x<=880;x+=40){
      const y = 60 + Math.sin(x*0.045+t)*16 + Math.sin(x*0.02+t*1.7)*8;
      d += `L${x},${y} `;
    }
    path.setAttribute('d', d);
    requestAnimationFrame(frame);
  }
  frame();
}

