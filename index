function startMeasure(){
  if(measuring) return;
  measuring = true;
  const btn = document.getElementById('measureBtn');
  btn.disabled = true; btn.textContent = '측정 중… (시뮬레이션)';
  document.getElementById('fillA').style.height='0%';
  document.getElementById('fillT').style.height='0%';
  document.getElementById('fillB').style.height='0%';
  document.getElementById('measureResult').innerHTML='';
  setTimeout(()=>{
    const a = 40+Math.round(Math.random()*30), th = 30+Math.round(Math.random()*30), b = 20+Math.round(Math.random()*25);
    document.getElementById('fillA').style.height=a+'%';
    document.getElementById('fillT').style.height=th+'%';
    document.getElementById('fillB').style.height=b+'%';
    const stress = Math.max(20, 100-a-Math.round(th*0.4));
    const recs = ['힐링명상 · 국악풍류 소리치유원','자연숲치유 · 계룡산 숲치유센터','한방 · 오정법 체질 스파'];
    const rec = recs[Math.floor(Math.random()*recs.length)];
    document.getElementById('measureResult').innerHTML = `
      <div class="rec-box">
        <div style="font-size:12.5px; color:var(--jade-light); font-weight:700; letter-spacing:.04em">AGENT AI 추천 결과</div>
        <div style="font-size:22px; font-family:'IBM Plex Mono',monospace; color:var(--jade); margin:8px 0">스트레스 지수 ${stress}</div>
        <p style="margin:6px 0">추천 치유 유형: <b>${rec}</b></p>
        <button class="btn btn-seal" style="margin-top:10px" onclick="go('explore')">추천 시설 탐색하기 →</button>
      </div>`;
    btn.disabled=false; btn.textContent='다시 측정하기';
    measuring=false;
    toast('측정이 완료되었습니다');
  }, 2200);
}

