function go(view, param){
  currentView = view;
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.querySelectorAll('nav.tabs button').forEach(b=>b.classList.toggle('active', b.dataset.tab===view));
  const target = document.getElementById('view-'+view);
  if(target){ target.classList.add('active'); }
  window.scrollTo({top:0, behavior:'smooth'});
  if(view==='siteDetail') renderSiteDetail(param);
  if(view==='articleDetail') renderArticleDetail(param);
  if(view==='ebookDetail') renderEbookDetail(param);
  if(view==='booking') renderBooking(param);
  if(view==='journey') renderJourney();
  if(view==='measure') renderMeasure();
  if(view==='psst') renderPsst(param);
  if(view==='auth') setAuthTab('login');
}

