    return;
  }
  const latest = JOURNEY_TREND[JOURNEY_TREND.length-1].v;
  const first = JOURNEY_TREND[0].v;
  const delta = Math.round(((first-latest)/first)*100);
  const maxV = Math.max(...JOURNEY_TREND.map(x=>x.v));
  const pts = JOURNEY_TREND.map((p,i)=>{
