  const path = pts.map((p,i)=> (i===0?'M':'L')+p.x+','+p.y ).join(' ');
  gate.innerHTML = `
    <div class="stat-row">
      <div class="stat"><div class="lbl">최근 스트레스 지수</div><div class="val">${latest}</div></div>
